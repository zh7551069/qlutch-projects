# 本地开发样例。复制为 .env 后再启动。不要写入真实密钥。
# 下面的口令只给本机 Docker Compose 使用，不是生产凭证。

# 进程。API 根地址是 http://127.0.0.1:4710
QLUTCH_ENV=local
# 内测取码。仅当 QLUTCH_ENV=staging 且此值非空时，API 才注册取码接口。
# 留空。不要填写口令。production 与其他环境忽略此变量，不回传验证码，也不记明文。
QLUTCH_STAGING_OTP_TOKEN=
QLUTCH_HTTP_ADDR=:4710
QLUTCH_CORS_ORIGINS=http://127.0.0.1:4712,http://localhost:4712

# PostgreSQL。宿主机端口 4713。
QLUTCH_DATABASE_URL=postgres://qlutch:qlutch-local-dev@127.0.0.1:4713/qlutch?sslmode=disable

# Redis。宿主机端口 4714。
QLUTCH_REDIS_ADDR=127.0.0.1:4714
QLUTCH_WORKER_QUEUE=qlutch:worker:jobs
QLUTCH_WORKER_HEARTBEAT=30s

# S3 兼容对象存储。API 端口 4715，控制台端口 4716。
QLUTCH_S3_ENDPOINT=http://127.0.0.1:4715
QLUTCH_S3_REGION=us-east-1
QLUTCH_S3_BUCKET=qlutch-local
QLUTCH_S3_ACCESS_KEY=qlutch
QLUTCH_S3_SECRET_KEY=qlutch-local-dev

# OpenTelemetry。留空表示只保留进程内追踪钩子，不向收集器导出。
QLUTCH_OTLP_ENDPOINT=

# 导入识别。名称留空表示不安装提供方。不要填写密钥，也不要填写调用根地址。
QLUTCH_LLM_API_KEY=
QLUTCH_LLM_BASE_URL=
QLUTCH_LLM_MODEL_S01_OCR=
QLUTCH_LLM_MODEL_S01_ASR=
QLUTCH_LLM_MODEL_S01_TEXT=

# 后管。开发地址是 http://127.0.0.1:4712
VITE_QLUTCH_ENV=local
VITE_QLUTCH_API_BASE=http://127.0.0.1:4710
